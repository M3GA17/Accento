{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Local settings window; no filesystem or shell APIs exposed to JavaScript.",
  "windows": [
    "settings",
    "picker"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy"
  ]
}
